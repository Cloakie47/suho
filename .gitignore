# Foundry build artifacts
contracts/out/
contracts/cache/
# NOTE: broadcast logs are NOT ignored here — contracts/.gitignore (Foundry's own)
# does `!/broadcast` and tracks real-chain deploy records as provenance, excluding
# only local anvil (31337) and dry-runs. A root `contracts/broadcast/` line would be
# dead (overridden by the nested negation) and misleading, so it is intentionally absent.

# Node
node_modules/
app/dist/

# Secrets — never commit keys or env files
.env
.env.*
*.env
!.env.example

# Local tool settings
.claude/settings.local.json

# Probe scratch (keep the webauthn probe: guardian /demo-credential reads it)
probe-tmp/*
!probe-tmp/webauthn/

# Guardian local code log (plaintext testnet OTPs)
guardian/codes.log

# VitePress
docs/.vitepress/cache/
docs/.vitepress/.temp/
